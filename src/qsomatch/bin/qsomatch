def loadFiles(args, cdb, contestID, ctl, db)
  begin
    if db and cdb
      db.begin_transaction
    end
    catout = nil
    if $catcheck
      catout = open("category_check.csv", "w:ascii")
      catout.write('"Callsign","Cab Power","Cab Class","Web Power","Web Class","Power","Class"' + "\n")
    end
    args.each { |filename|
      begin
        cab = Cabrillo.new(filename)
        if cab and cdb
          addLog(cdb, contestID, cab, ctl)
        end
        if $cabcheck
          if cab
            if not cab.cleanparse
              $stderr.flush
              $stdout.flush
              print "Station: #{cab.logcall}:#{filename} failed to parse.\n"
              $stdout.flush
            end
            if not cab.badmults.empty?
              $stderr.flush
              $stdout.flush
              print "Station: #{cab.logcall}:#{filename} has bad #{cab.badmults.size} multipliers in #{cab.qsos.size} QSO(s).\n"
              print "Multipliers: " + cab.badmults.to_a.join(" ") + "\n"
              $stdout.flush
            end
            if not cab.defaultSentQTH  or cab.defaultSentQTH == "CA"
              $stderr.flush
              $stdout.flush
              print "Station: #{cab.logcall}:#{filename} has bad sent QTH #{cab.defaultSentQTH} in the header\n"
              $stdout.flush
            end
            if not cab.badSentMults.empty?
              $stderr.flush
              $stdout.flush
              print "Station: #{cab.logcall}:#{filename} has bad sent QTHs in QSO lines: #{cab.badSentMults.to_a.join(" ")}\n"
              $stdout.flush
            end
          else
            $stdout.flush
            $stderr.flush
            print "#{filename} failed to parse at all.\n"
            $stdout.flush
          end
        end
        if $catcheck
          if cab.conflicted?
            catout.write( '"' + cab.logCall + '","' +
              ((not cab.logCat.power.nil?) ? cab.logCat.power.to_s.upcase :
               cab.dbCat.power.to_s.upcase) + '","' +
              ((not cab.logCat.numop.nil?) ? cab.classFromCat(cab.logCat) :
               cab.classFromCat(cab.dbCat)) + '","' +
              cab.logPower + '","' + cab.cqpOpClass + '","' +
                          cab.logPower + '","' + cab.cqpOpClass + "\",\"" +
                          cab.logEmail.to_s + "\"\n")
          end
        end
      rescue ArgumentError => e
        $stderr.flush
        $stdout.flush
        print "#{filename} caused an exception #{e}\n"
        $stdout.flush
      end
    }
  ensure
    if db and cdb
      db.end_transaction
    end
    if catout
      catout.close
    end
  end
  if cdb
    cdb.checkDupeLogs(contestID)
  end
end

class AllIncluded
  def include?(str)
    true
  end

  def useQRZ?
    true
  end
end


def isDXCall(callsign)
  dm = CallsignLocator.new
  entity = dm.lookup(callsign)
  if entity
    return entity.dx?
  end
  false
end

def checkCallsigns(db, cid, user, pwd)
  if user and pwd
    qrz = QRZLookup.new(user, pwd)
  else
    qrz = nil
  end
  xmldb = readXMLDb()
  fcc = nil
  if $fccdb
    fcc = FCC.new($fccdb)
  else
    print "Running with *NO* FCC license file!\n"
  end
  if $canadadb
    canada = loadCanadianLicenses($canadadb)
    canada.freeze
  else
    print "Running with *NO* Canadian license file!\n"
    canada = nil
  end
  if File.readable?("valid1x1.json")
    validOneByOnes = Set.new(JSON.parse(File.read("valid1x1.json")))
    def validOneByOnes.useQRZ?
      false
    end
  else
    $stderr.write("Missing valid1x1.json\n")
    validOneByOnes = AllIncluded.new # says everything is valid
  end
  locator = CallsignLocator.new
  db.query("select id, basecall from Callsign where contestID = ? and validcall is null order by basecall asc;", [cid.to_i]) { |row|
    if row[1].length > 3 or validOneByOnes.useQRZ?
      if xmldb.has_key?(row[1]) 
        db.query("update Callsign set validcall = ? where id = ?;",
                 [(xmldb[row[1]] ? 1 : 0), row[0].to_i])
      else
        ent = locator.lookup(row[1])
        if ent
          if ent.fcc?
            if fcc
              if fcc.validHFLicense?(row[1])
                lookupCall(qrz, xmldb, row[1])
                db.query("update Callsign set validcall = 1 where id = ?;",
                         [row[0].to_i])
              else
                print "US callsign is not valid: #{row[1]}\n"
                db.query("update Callsign set validcall = #{db.false}, illegalcall=#{db.true} where id = ?;", [row[0].to_i])
              end
            else
              # no FCC database available use QRZ
              if lookupCall(qrz, xmldb, row[1])
                db.query("update Callsign set validcall = 1 where id = ?;",
                         [row[0].to_i])
              else
                print "US callsign is not known to QRZ: #{row[1]}\n"
                db.query("update Callsign set validcall = 0 where id = ?;",
                         [row[0].to_i])
              end
            end
          elsif ent.canadian?
            if canada
              if canada.has_key?(row[1])
                # known Canadian license from file
                db.query("update Callsign set validcall = 1 where id = ?;",
                         [row[0].to_i])
              else
                print "Canadian callsign #{row[1]} is not licensed\n"
                db.query("update Callsign set validcall = 0, illegalcall=1 where id = ?;",
                         [row[0].to_i])
              end
            else
              if lookupCall(qrz, xmldb, row[1]) or ent.dx?
                db.query("update Callsign set validcall = 1 where id = ?;",
                         [row[0].to_i])
              else
                print "Callsign #{row[1]} is not known to QRZ\n"
                db.query("update Callsign set validcall = 0 where id = ?;",
                         [row[0].to_i])
              end
            end
          else
            if lookupCall(qrz, xmldb, row[1]) or ent.dx?
              # QRZ is not a reliable authority for DX
              db.query("update Callsign set validcall = 1 where id = ?;",
                       [row[0].to_i])
            end
          end   
        else
          if lookupCall(qrz, xmldb, row[1])
            # QRZ is not a reliable authority for DX
            db.query("update Callsign set validcall = 1 where id = ?;",
                     [row[0].to_i])
          else
            print "Callsign #{row[1]} is unknown to QRZ and entity can't be determined.\n"
            db.query("update Callsign set validcall = #{db.false}, illegalcall=#{db.true} where id = ?;",
                     [row[0].to_i])
          end
        end
      end
    else
      if validOneByOnes.include?(row[1])
        db.query("update Callsign set validcall = 1 where id = ?;",
                 [row[0].to_i]);
      else
        db.query("update Callsign set validcall = 0 where id = ?;",
                 [row[0].to_i]);
      end
    end
  }
  if File.readable?("illegalcalls.json")
    list = JSON.parse(File.read("illegalcalls.json"))
    list.each { |callsign|
      db.query("update Callsign set validcall = 0, illegalcall = 1 where basecall= ?;",
               [ callsign ])
    }
  else
    $stderr.write("Missing illegalcalls.json\n")
  end
end

NUMSECS=5
NUMDOTS=3
def restartContest(cm)
  print "Restarting in 5 seconds: "
  NUMSECS.times { |i|
    print (NUMSECS-i).to_s
    NUMDOTS.times { 
      sleep (1.0/NUMDOTS)
      print "."
      $stdout.flush
    }
  }
  print "0  Done.\n"
  $stdout.flush
  cm.restartMatch
end

